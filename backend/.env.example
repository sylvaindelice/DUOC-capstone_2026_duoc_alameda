# Copia este archivo a .env y ajusta los valores. Todas las variables usan
# el prefijo APP_ (ver app/config.py).

APP_DATABASE_URL=sqlite:///./identidad.db

# Umbral de decisión del motor facial activo. Déjalo vacío para usar el
# valor por defecto (0.6 para face_recognition, 0.90 para el respaldo OpenCV+LBP).
APP_FACE_MATCH_THRESHOLD=

# Control de asistencia — ventana móvil de 24h (ver README / sección 5.3 de la propuesta)
APP_AVISO_PREVIO_HORAS=20
APP_AVISO_FINAL_HORAS=24
APP_SCHEDULER_INTERVAL_MINUTOS=60

# Envío de correo. Si APP_SMTP_ENABLED=False, los correos solo quedan en el log
# (útil para desarrollar y hacer la demo sin configurar SMTP real).
APP_SMTP_ENABLED=False
APP_SMTP_HOST=smtp.gmail.com
APP_SMTP_PORT=587
APP_SMTP_USE_TLS=True
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=no-reply@identidad-app.local
