ScreenManager:
    RegistroScreen:
        name: "registro"
    PersonasScreen:
        name: "personas"
    VerificacionScreen:
        name: "verificacion"
    HistorialScreen:
        name: "historial"


<RegistroScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: "8dp"
        
        MDTopAppBar:
            type: "small"

            MDTopAppBarTitle:
                text: "Registrar persona"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "account-multiple"
                    on_release: app.root.current = "personas"

        MDTextField:
            id: campo_nombre
            size_hint_y: None
            height: "56dp"
            padding: "12dp", "8dp"

            MDTextFieldHintText:
                text: "Nombre completo"

        MDTextField:
            id: campo_email
            size_hint_y: None
            height: "56dp"
            padding: "12dp", "8dp"

            MDTextFieldHintText:
                text: "Correo electrónico"

        Camera:
            id: camera_registro
            resolution: (640, 480)
            play: True

        MDButton:
            style: "elevated"
            pos_hint: {"center_x": 0.5}
            size_hint_y: None
            height: "48dp"
            on_release: app.capturar_y_registrar()

            MDButtonText:
                text: "Capturar foto y registrar"


<PersonasScreen>:
    BoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarTitle:
                text: "Personas registradas"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "account-plus"
                    on_release: app.root.current = "registro"

        MDButton:
            style: "elevated"
            pos_hint: {"center_x": 0.5}
            size_hint_y: None
            height: "40dp"
            on_release: app.refrescar_personas()

            MDButtonText:
                text: "Actualizar lista"

        ScrollView:
            MDList:
                id: lista_personas


<VerificacionScreen>:
    BoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.root.current = "personas"

            MDTopAppBarTitle:
                text: "Verificar: " + root.persona_nombre

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "history"
                    on_release: app.refrescar_historial(); app.root.current = "historial"

        Camera:
            id: camera_verificacion
            resolution: (640, 480)
            play: True

        MDButton:
            style: "elevated"
            pos_hint: {"center_x": 0.5}
            size_hint_y: None
            height: "48dp"
            on_release: app.capturar_y_verificar()

            MDButtonText:
                text: "Capturar selfie y verificar"

        MDLabel:
            text: root.resultado_texto
            halign: "center"
            theme_text_color: "Custom"
            text_color: root.resultado_color
            size_hint_y: None
            height: "80dp"


<HistorialScreen>:
    BoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.root.current = "verificacion"

            MDTopAppBarTitle:
                text: "Historial de verificaciones"

        ScrollView:
            MDList:
                id: lista_eventos
